PLATFORM_PATH := device/sony/yoshino-common

### BUILD SYSTEM (ANDROID 16 / AERA 16.0 COMPATIBILITY)
ALLOW_MISSING_DEPENDENCIES := true
BUILD_BROKEN_DUP_RULES := true
BUILD_BROKEN_ELF_PREBUILT_PRODUCT_COPY_FILES := true
BUILD_BROKEN_PLUGIN_VALIDATION := \
    soong-libaosprecovery_defaults \
    soong-libguitwrp_defaults \
    soong-libminuitwrp_defaults \
    soong-vold_defaults

### BOARD & PLATFORM
BOARD_USES_QCOM_HARDWARE := true
BOARD_VENDOR := sony
TARGET_NO_BOOTLOADER ?= true
TARGET_BOARD_PLATFORM := msm8998
TARGET_BOARD_PLATFORM_GPU := qcom-adreno540
QCOM_BOARD_PLATFORMS += msm8998
TARGET_USES_ION := true

### ARCHITECTURE & PROCESSOR (SNAPDRAGON 835 / MSM8998)
TARGET_ARCH := arm64
TARGET_ARCH_VARIANT := armv8-a
TARGET_CPU_ABI := arm64-v8a
TARGET_CPU_ABI2 :=
TARGET_CPU_VARIANT := generic
TARGET_CPU_VARIANT_RUNTIME := cortex-a73

TARGET_2ND_ARCH := arm
TARGET_2ND_ARCH_VARIANT := armv8-a
TARGET_2ND_CPU_ABI := armeabi-v7a
TARGET_2ND_CPU_ABI2 := armeabi
TARGET_2ND_CPU_VARIANT := generic
TARGET_2ND_CPU_VARIANT_RUNTIME := cortex-a73

### KERNEL & BOOT IMAGE
TARGET_KERNEL_ARCH := arm64
TARGET_KERNEL_HEADER_ARCH := arm64
BOARD_KERNEL_IMAGE_NAME ?= Image.gz-dtb

BOARD_KERNEL_CMDLINE += user_debug=31
BOARD_KERNEL_CMDLINE += ehci-hcd.park=3
BOARD_KERNEL_CMDLINE += lpm_levels.sleep_disabled=1
BOARD_KERNEL_CMDLINE += sched_enable_hmp=1
BOARD_KERNEL_CMDLINE += sched_enable_power_aware=1
BOARD_KERNEL_CMDLINE += service_locator.enable=1
BOARD_KERNEL_CMDLINE += swiotlb=2048
BOARD_KERNEL_CMDLINE += androidboot.configfs=true
BOARD_KERNEL_CMDLINE += androidboot.usbcontroller=a800000.dwc3
BOARD_KERNEL_CMDLINE += loop.max_part=7
BOARD_KERNEL_CMDLINE += zram.backend=z3fold
BOARD_KERNEL_CMDLINE += androidboot.selinux=permissive

BOARD_KERNEL_BASE := 0x00000000
BOARD_KERNEL_PAGESIZE := 4096
BOARD_BOOT_HEADER_VERSION ?= 0
BOARD_MKBOOTIMG_ARGS += --header_version $(BOARD_BOOT_HEADER_VERSION)
BOARD_MKBOOTIMG_ARGS += --pagesize $(BOARD_KERNEL_PAGESIZE)

### PARTITIONS & FILESYSTEMS
# Fixed 64 MiB boot and recovery slots on Sony Yoshino (MSM8998)
AB_OTA_UPDATER := false
BOARD_BOOTIMAGE_PARTITION_SIZE := 67108864
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 67108864
BOARD_CACHEIMAGE_PARTITION_SIZE := 398458880
BOARD_FLASH_BLOCK_SIZE := 131072 # (BOARD_KERNEL_PAGESIZE * 64)

BOARD_CACHEIMAGE_FILE_SYSTEM_TYPE := ext4
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_USE_F2FS := true
TARGET_USES_MKE2FS := true
TARGET_COPY_OUT_VENDOR := vendor

# Legacy F2FS SDK marker
CM_PLATFORM_SDK_VERSION := 3

### ENCRYPTION (MSM8998 KEYMASTER 3.0 + FSCRYPT V1 ICE)
BOARD_USES_QCOM_FBE_DECRYPTION := true
PLATFORM_VERSION := 99.87.36
PLATFORM_VERSION_LAST_STABLE := $(PLATFORM_VERSION)
PLATFORM_SECURITY_PATCH := 2099-12-31
VENDOR_SECURITY_PATCH := $(PLATFORM_SECURITY_PATCH)
BOOT_SECURITY_PATCH := $(PLATFORM_SECURITY_PATCH)

AERA_INCLUDE_CRYPTO := true
AERA_INCLUDE_CRYPTO_FBE := true
AERA_USE_FSCRYPT_POLICY := 1
AERA_DEFAULT_KEYMASTER_VERSION := 3.0
AERA_FORCE_KEYMASTER_VER := true

TW_INCLUDE_CRYPTO := true
TW_INCLUDE_CRYPTO_FBE := true
TW_USE_FSCRYPT_POLICY := 1
OF_DEFAULT_KEYMASTER_VERSION := 3.0
TW_FORCE_KEYMASTER_VER := true

# Export FBE v1, Legacy KGSL GPU, and WLAN flags to Soong twrpVarsPlugin
AERA_UI_LEGACY_KGSL_GPU := true
AERA_ENABLE_WLAN := 1
OF_ENABLE_WLAN := 1
AERA_EXCLUDE_OFFLINE_ROOT_PROVIDERS := 1

SOONG_CONFIG_NAMESPACES += twrpVarsPlugin
SOONG_CONFIG_twrpVarsPlugin += \
    TW_USE_FSCRYPT_POLICY \
    AERA_UI_LEGACY_KGSL_GPU \
    OF_ENABLE_WLAN
SOONG_CONFIG_twrpVarsPlugin_TW_USE_FSCRYPT_POLICY := $(TW_USE_FSCRYPT_POLICY)
SOONG_CONFIG_twrpVarsPlugin_AERA_UI_LEGACY_KGSL_GPU := true
SOONG_CONFIG_twrpVarsPlugin_OF_ENABLE_WLAN := true

### RECOVERY MODULES & RELINK LIBRARIES
# Note: recovery/lib64/libandroidicu.so is copied into the device recovery ramdisk
# by patches/apply.sh for Android 16's /system/lib64/libxml2.so -> libdrmfs.so -> qseecomd.
TARGET_RECOVERY_DEVICE_MODULES += \
    android.hardware.boot-V1-ndk \
    android.hardware.keymaster@3.0-impl \
    android.hardware.weaver@1.0 \
    libboot_control_client \
    libkeymaster3device \
    libpuresoftkeymasterdevice

AERA_RECOVERY_ADDITIONAL_RELINK_LIBRARY_FILES += \
    $(TARGET_OUT_VENDOR_SHARED_LIBRARIES)/hw/android.hardware.keymaster@3.0-impl.so \
    $(TARGET_OUT_SHARED_LIBRARIES)/libkeymaster3device.so \
    $(TARGET_OUT_SHARED_LIBRARIES)/libpuresoftkeymasterdevice.so \
    $(TARGET_OUT_SHARED_LIBRARIES)/android.hardware.boot-V1-ndk.so \
    $(TARGET_OUT_SHARED_LIBRARIES)/libboot_control_client.so \
    $(TARGET_OUT_SHARED_LIBRARIES)/android.hardware.weaver@1.0.so

### INIT, USB & WIFI
AERA_EXCLUDE_DEFAULT_USB_INIT := true
TW_EXCLUDE_DEFAULT_USB_INIT := true
TARGET_RECOVERY_DEVICE_MODULES += \
    init.recovery.usb.rc \
    init.recovery.wifi.rc
TARGET_USE_CUSTOM_LUN_FILE_PATH := /config/usb_gadget/g1/functions/mass_storage.0/lun.%d/file

### QCOM SPECIFICS
TARGET_RECOVERY_QCOM_RTC_FIX := true
AERA_NEW_ION_HEAP := true
TW_NEW_ION_HEAP := true

### AERA DISPLAY, GRAPHICS & UI METRICS
TARGET_RECOVERY_PIXEL_FORMAT := RGBX_8888
AERA_THEME := portrait_hdpi
TW_THEME := portrait_hdpi
AERA_UI_ADAPTIVE_RESOLUTION := true
AERA_FRAMERATE := 60
TW_FRAMERATE := 60
AERA_SCREEN_H := 1920
AERA_STATUS_H := 124
AERA_STATUS_INDENT_LEFT := 54
AERA_STATUS_INDENT_RIGHT := 54

### BRIGHTNESS, THERMAL & BATTERY PATHS
AERA_NO_SCREEN_BLANK := true
TW_NO_SCREEN_BLANK := true
AERA_BRIGHTNESS_PATH := "/sys/class/leds/wled/brightness"
AERA_MAX_BRIGHTNESS := 4095
AERA_DEFAULT_BRIGHTNESS := 1600
TW_BRIGHTNESS_PATH := /sys/class/leds/wled/brightness
TW_MAX_BRIGHTNESS := 4095
TW_DEFAULT_BRIGHTNESS := 1600

AERA_CUSTOM_CPU_TEMP_PATH := "/sys/class/thermal/thermal_zone4/temp"
TW_CUSTOM_CPU_TEMP_PATH := /sys/class/thermal/thermal_zone4/temp

AERA_CUSTOM_BATTERY_PATH := "/sys/class/power_supply/bms"
TW_CUSTOM_BATTERY_PATH := /sys/class/power_supply/bms
AERA_USE_LEGACY_BATTERY_SERVICES := 1
OF_USE_LEGACY_BATTERY_SERVICES := 1

### AERA TOOLS, STORAGE & RAMDISK CONFIGURATION
# Default to single-language font pack to keep recovery image within 64 MiB slot
AERA_DEFAULT_LANGUAGE ?= en
AERA_EXTRA_LANGUAGES ?= false
TW_EXTRA_LANGUAGES := $(AERA_EXTRA_LANGUAGES)

AERA_INCLUDE_RESETPROP := true
AERA_INCLUDE_LIBRESETPROP := true
AERA_INCLUDE_REPACKTOOLS := true
TW_INCLUDE_RESETPROP := true
TW_INCLUDE_LIBRESETPROP := true
TW_INCLUDE_REPACKTOOLS := true

AERA_INCLUDE_LOGCAT := true
TWRP_INCLUDE_LOGCAT := true
TARGET_USES_LOGD := true

AERA_USE_TOOLBOX := true
TW_USE_TOOLBOX := true

AERA_INCLUDE_NTFS_3G := true
AERA_INCLUDE_FUSE_EXFAT := true
AERA_INCLUDE_FUSE_NTFS := true
AERA_NO_EXFAT_FUSE := true
TW_INCLUDE_NTFS_3G := true
TW_INCLUDE_FUSE_EXFAT := true
TW_INCLUDE_FUSE_NTFS := true
TW_NO_EXFAT_FUSE := true

AERA_EXCLUDE_APEX := true
TW_EXCLUDE_APEX := true
TW_EXCLUDE_SUPERSU := true
TW_EXCLUDE_TWRPAPP := true
AERA_EXCLUDE_NANO := true
TW_EXCLUDE_NANO := true
AERA_EXCLUDE_NANO_EDITOR := 1
AERA_REMOVE_BASH := 1
AERA_REMOVE_AAPT := 1
AERA_HAS_NO_RECOVERY_PARTITION := false
TW_HAS_NO_RECOVERY_PARTITION := false
BOARD_HAS_NO_REAL_SDCARD := true
RECOVERY_SDCARD_ON_DATA := true
AERA_IGNORE_MISC_WIPE_DATA := true
TW_IGNORE_MISC_WIPE_DATA := true
AERA_INPUT_BLACKLIST := "hbtp_vm"
TW_INPUT_BLACKLIST := "hbtp_vm"
AERA_SKIP_ADDITIONAL_FSTAB := true
OF_SKIP_ADDITIONAL_FSTAB := true
AERA_SKIP_DECRYPTED_ADOPTED_STORAGE := true
OF_SKIP_DECRYPTED_ADOPTED_STORAGE := true
AERA_NO_TREBLE_COMPATIBILITY_CHECK := 1
OF_NO_TREBLE_COMPATIBILITY_CHECK := 1
