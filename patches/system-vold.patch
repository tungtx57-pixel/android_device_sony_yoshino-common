+#ifdef USE_FSCRYPT_POLICY_V1
+static bool fillLegacyKey(const KeyBuffer& key, fscrypt_key* fs_key) {
+    if (key.size() != FSCRYPT_MAX_KEY_SIZE) {
+        LOG(ERROR) << "Wrong size legacy fscrypt key " << key.size();
+        return false;
+    }
+    fs_key->mode = 0;
+    fs_key->size = key.size();
+    memcpy(fs_key->raw, key.data(), key.size());
+    return true;
+}
+
+static bool installLegacyKey(const KeyBuffer& key, const std::string& raw_ref) {
+    key_serial_t keyring = keyctl_search(KEY_SPEC_SESSION_KEYRING, "keyring", "fscrypt", 0);
+    if (keyring == -1 && errno == ENOKEY) {
+        keyring = add_key("keyring", "fscrypt", nullptr, 0, KEY_SPEC_SESSION_KEYRING);
+    }
+    if (keyring == -1) {
+        PLOG(ERROR) << "Unable to find or create the legacy fscrypt keyring";
+        return false;
+    }
+
+    KeyBuffer key_buffer(sizeof(fscrypt_key), 0);
+    fscrypt_key& fs_key = *reinterpret_cast<fscrypt_key*>(key_buffer.data());
+    if (!fillLegacyKey(key, &fs_key)) return false;
+
+    static constexpr const char* kPrefixes[] = {"ext4", "f2fs", "fscrypt"};
+    for (const char* prefix : kPrefixes) {
+        const std::string description = prefix + std::string(":") + keyrefstring(raw_ref);
+        if (add_key("logon", description.c_str(), &fs_key, sizeof(fs_key), keyring) == -1) {
+            PLOG(ERROR) << "Failed to install legacy fscrypt key " << description;
+            return false;
+        }
+    }
+    LOG(INFO) << "Installed v1 fscrypt key through the legacy session keyring";
+    return true;
+}
+#endif
+
