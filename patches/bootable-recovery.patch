+    LOAD_GRALLOC(destroy, GRALLOC1_PFN_DESTROY_DESCRIPTOR, GRALLOC1_FUNCTION_DESTROY_DESCRIPTOR);
+    LOAD_GRALLOC(dimensions, GRALLOC1_PFN_SET_DIMENSIONS, GRALLOC1_FUNCTION_SET_DIMENSIONS);
+    LOAD_GRALLOC(format, GRALLOC1_PFN_SET_FORMAT, GRALLOC1_FUNCTION_SET_FORMAT);
+    LOAD_GRALLOC(consumer, GRALLOC1_PFN_SET_CONSUMER_USAGE, GRALLOC1_FUNCTION_SET_CONSUMER_USAGE);
+    LOAD_GRALLOC(producer, GRALLOC1_PFN_SET_PRODUCER_USAGE, GRALLOC1_FUNCTION_SET_PRODUCER_USAGE);
