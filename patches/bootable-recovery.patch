+  bool PresentMinuiDirectSoftware(const uint8_t *pixels) {
+    unsigned char *dst_bytes = nullptr;
+    int dst_w = 0;
+    int dst_h = 0;
+    int dst_row_bytes = 0;
+    __u32 dst_format = 0;
+    if (pixels == nullptr ||
+        gr_get_frame_target(&dst_bytes, &dst_w, &dst_h, &dst_row_bytes,
+                            &dst_format) != 0) {
+      return false;
+    }
+    if (dst_w != physical_width_ || dst_h != physical_height_ ||
+        width_ <= 0 || height_ <= 0) {
+      return false;
+    }
+
+    const bool swizzle_rb = (dst_format == GGL_PIXEL_FORMAT_RGBA_8888 ||
+                             dst_format == GGL_PIXEL_FORMAT_RGBX_8888);
+    const auto *src_all = reinterpret_cast<const uint32_t *>(pixels);
+
+    if (width_ == dst_w && height_ == dst_h) {
+      for (int32_t y = 0; y < dst_h; ++y) {
+        const uint32_t *src_row =
+            src_all + static_cast<size_t>(y) * static_cast<size_t>(width_);
+        auto *dst_row = reinterpret_cast<uint32_t *>(
+            dst_bytes + static_cast<size_t>(y) * dst_row_bytes);
+        if (!swizzle_rb) {
+          memcpy(dst_row, src_row, static_cast<size_t>(dst_w) * sizeof(uint32_t));
+        } else {
+          for (int32_t x = 0; x < dst_w; ++x) {
+            const uint32_t p = src_row[x];
+            dst_row[x] = (p & 0xFF00FF00u) |
+                         ((p & 0x00FF0000u) >> 16) |
+                         ((p & 0x000000FFu) << 16);
+          }
+        }
+      }
+      gr_flip();
+      return true;
+    }
+
+    if (minui_x_index_.size() != static_cast<size_t>(dst_w) ||
+        minui_src_w_ != width_ || minui_dst_w_ != dst_w) {
+      minui_src_w_ = width_;
+      minui_dst_w_ = dst_w;
+      minui_x_index_.resize(static_cast<size_t>(dst_w));
+      minui_x_weight_.resize(static_cast<size_t>(dst_w));
+      for (int32_t x = 0; x < dst_w; ++x) {
+        const int64_t num = (static_cast<int64_t>(x) * 2 + 1) * width_ * 8 -
+                            static_cast<int64_t>(dst_w) * 8;
+        const int64_t fp = std::max<int64_t>(0, num / dst_w);
+        int32_t sx = static_cast<int32_t>(fp >> 4);
+        uint32_t wx = static_cast<uint32_t>(fp & 0xF);
+        if (sx >= width_ - 1) {
+          sx = width_ - 1;
+          wx = 0;
+        }
+        minui_x_index_[static_cast<size_t>(x)] = sx;
+        minui_x_weight_[static_cast<size_t>(x)] = static_cast<uint8_t>(wx);
+      }
+    }
+
+    const int32_t *x_idx = minui_x_index_.data();
+    const uint8_t *x_w = minui_x_weight_.data();
+    for (int32_t y = 0; y < dst_h; ++y) {
+      const int64_t num_y = (static_cast<int64_t>(y) * 2 + 1) * height_ * 8 -
+                            static_cast<int64_t>(dst_h) * 8;
+      const int64_t fp_y = std::max<int64_t>(0, num_y / dst_h);
+      int32_t sy0 = static_cast<int32_t>(fp_y >> 4);
+      uint32_t wy = static_cast<uint32_t>(fp_y & 0xF);
+      int32_t sy1 = sy0 + 1;
+      if (sy0 >= height_ - 1) {
+        sy0 = height_ - 1;
+        sy1 = sy0;
+        wy = 0;
+      }
+      const uint32_t iy = 16u - wy;
+      const uint32_t *row0 =
+          src_all + static_cast<size_t>(sy0) * static_cast<size_t>(width_);
+      const uint32_t *row1 =
+          src_all + static_cast<size_t>(sy1) * static_cast<size_t>(width_);
+      auto *dst_row = reinterpret_cast<uint32_t *>(
+          dst_bytes + static_cast<size_t>(y) * dst_row_bytes);
+
+      for (int32_t x = 0; x < dst_w; ++x) {
+        const int32_t sx0 = x_idx[x];
+        const uint32_t wx = x_w[x];
+        const int32_t sx1 = sx0 + (wx != 0 ? 1 : 0);
+        const uint32_t ix = 16u - wx;
+
+        const uint32_t w00 = ix * iy;
+        const uint32_t w01 = wx * iy;
+        const uint32_t w10 = ix * wy;
+        const uint32_t w11 = wx * wy;
+
+        const uint32_t p00 = row0[sx0];
+        const uint32_t p01 = row0[sx1];
+        const uint32_t p10 = row1[sx0];
+        const uint32_t p11 = row1[sx1];
+
+        const uint32_t rb_sum =
+            (p00 & 0x00FF00FFu) * w00 + (p01 & 0x00FF00FFu) * w01 +
+            (p10 & 0x00FF00FFu) * w10 + (p11 & 0x00FF00FFu) * w11;
+        const uint32_t ga_sum =
+            ((p00 >> 8) & 0x00FF00FFu) * w00 + ((p01 >> 8) & 0x00FF00FFu) * w01 +
+            ((p10 >> 8) & 0x00FF00FFu) * w10 + ((p11 >> 8) & 0x00FF00FFu) * w11;
+
+        uint32_t rb = (rb_sum >> 8) & 0x00FF00FFu;
+        if (swizzle_rb) {
+          rb = (rb << 16) | (rb >> 16);
+        }
+        dst_row[x] = rb | (ga_sum & 0xFF00FF00u);
+      }
+    }
+    gr_flip();
+    return true;
+  }
