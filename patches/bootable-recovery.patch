+
+void ProfileLegacyFrame(lv_event_t* event) {
+  static uint64_t start = 0, total = 0, maximum = 0;
+  static unsigned frames = 0, over_budget = 0;
+  if (lv_event_get_code(event) == LV_EVENT_REFR_START) {
+    char value[PROP_VALUE_MAX]{};
+    __system_property_get("debug.aera.gpu_profile", value);
+    profile_frame_active = value[0] == '1';
+    profile_frame_presented = false;
+    if (profile_frame_active) start = ProfileNanoseconds();
+    else { total = maximum = frames = over_budget = 0; }
+  } else if (profile_frame_active && profile_frame_presented) {
+    const uint64_t elapsed = ProfileNanoseconds() - start;
+    total += elapsed;
+    if (elapsed > maximum) maximum = elapsed;
+    if (elapsed > 16666667ULL) ++over_budget;
+    if (++frames == 60) {
+      __android_log_print(ANDROID_LOG_INFO, kLogTag,
+          "legacy full refresh: average %.2f ms, max %.2f ms, over 60Hz budget %u/60",
+          total / 60000000.0, maximum / 1000000.0, over_budget);
+      total = maximum = frames = over_budget = 0;
+    }
+  }
+}
+
+void RecordLegacyTiming(uint64_t read_ns, uint64_t copy_ns, uint64_t wait_ns) {
+  static uint64_t total_read = 0;
+  static uint64_t total_copy = 0;
+  static uint64_t total_wait = 0;
+  static unsigned count = 0;
+  total_read += read_ns;
+  total_copy += copy_ns;
+  total_wait += wait_ns;
+  if (++count == 60) {
+    lv_opengles_cache_stats_t stats{};
+    lv_draw_opengles_profile(true, &stats);
+    __android_log_print(ANDROID_LOG_INFO, kLogTag,
+                        "legacy present (60 frames): GPU wait/readback %.2f ms, submit/flip %.2f ms, previous flip wait %.2f ms",
