+      __system_property_get(property, hardware);
+      if (hardware[0] == '\0' || std::strchr(hardware, '/') != nullptr) continue;
+      char path[160];
+      std::snprintf(path, sizeof(path), "/vendor/lib64/hw/gralloc.%s.so", hardware);
+      library = dlopen(path, RTLD_NOW | RTLD_LOCAL);
