+static void layer_viewport(unsigned int texture, int32_t logical_width, int32_t logical_height)
+{
+    lv_opengles_texture_get_render_size(texture, &logical_width, &logical_height);
+    lv_opengles_viewport(0, 0, logical_width, logical_height);
+}
+
+/* Use the same rounded boundary for adjoining rectangles, avoiding gaps or
+ * double-clears when logical pixels map to fractional framebuffer pixels. */
+static int32_t raster_edge(int32_t edge, int32_t logical_size, int32_t raster_size)
+{
+    return (int32_t)(((int64_t)edge * raster_size + logical_size / 2) / logical_size);
+}
+
+static lv_area_t raster_area(const lv_area_t * area, int32_t logical_width, int32_t logical_height,
+                              int32_t raster_width, int32_t raster_height)
+{
+    lv_area_t result;
+    result.x1 = raster_edge(area->x1, logical_width, raster_width);
+    result.y1 = raster_edge(area->y1, logical_height, raster_height);
+    result.x2 = raster_edge(area->x2 + 1, logical_width, raster_width) - 1;
+    result.y2 = raster_edge(area->y2 + 1, logical_height, raster_height) - 1;
+    return result;
+}
