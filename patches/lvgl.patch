 static bool runtime_enabled;
+static bool opacity_cache;
+static bool memory_cache;
+#define LEGACY_TEXTURE_BUDGET (64U * 1024U * 1024U)
+static bool cache_profile;
+static lv_opengles_cache_stats_t cache_stats;
+
+void lv_draw_opengles_set_opacity_cache(bool enabled)
+{
+    opacity_cache = enabled;
+    lv_opengles_set_draw_cache(enabled);
+}
+
+void lv_draw_opengles_invalidate_target(void)
+{
+    if(g_unit) {
+        g_unit->target_bound = false;
+        g_unit->attached_texture = 0;
+    }
+}
+
+static void bind_target(lv_draw_opengles_unit_t * u, unsigned int texture)
+{
+    if(texture == 0) {
+        GL_CALL(glBindFramebuffer(GL_FRAMEBUFFER, 0));
+        u->target_bound = false;
+        return;
+    }
+    unsigned int framebuffer = get_framebuffer(u);
+    if(!opacity_cache || !u->target_bound) {
+        GL_CALL(glBindFramebuffer(GL_FRAMEBUFFER, framebuffer));
+        u->target_bound = true;
+    }
+    if(!opacity_cache || u->attached_texture != texture) {
+        GL_CALL(glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, texture, 0));
+        u->attached_texture = texture;
+    }
+}
+
+static void finish_target(lv_draw_opengles_unit_t * u)
+{
+    if(!opacity_cache) {
+        GL_CALL(glBindFramebuffer(GL_FRAMEBUFFER, 0));
+        u->target_bound = false;
+    }
+}
+
+void lv_draw_opengles_profile(bool enabled, lv_opengles_cache_stats_t * stats)
+{
+    cache_profile = enabled;
+    if(stats) {
+        *stats = cache_stats;
+        lv_memzero(&cache_stats, sizeof(cache_stats));
+    }
+    if(!enabled) lv_memzero(&cache_stats, sizeof(cache_stats));
+}
+
+static lv_opa_t cache_shape_opacity(lv_draw_task_type_t type, draw_dsc_key_t * key)
+{
+    if(!opacity_cache) return LV_OPA_COVER;
+    lv_opa_t * opa = NULL;
+    if(type == LV_DRAW_TASK_TYPE_FILL && key->fill.grad.dir == LV_GRAD_DIR_NONE)
+        opa = &key->fill.opa;
+    else if(type == LV_DRAW_TASK_TYPE_BORDER)
+        opa = &key->border.opa;
+    else if(type == LV_DRAW_TASK_TYPE_BOX_SHADOW)
+        opa = &key->box_shadow.opa;
+    else if(type == LV_DRAW_TASK_TYPE_LABEL &&
+            key->label.outline_stroke_width == 0 && key->label.decor == LV_TEXT_DECOR_NONE &&
+            key->label.sel_start == LV_DRAW_LABEL_NO_TXT_SEL &&
+            key->label.sel_end == LV_DRAW_LABEL_NO_TXT_SEL)
+        opa = &key->label.opa;
+    if(!opa) return LV_OPA_COVER;
+    lv_opa_t original = *opa;
+    *opa = LV_OPA_COVER;
+    return original;
+}
 
